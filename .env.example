# ============================================
# OCR-LLM Distributed Chat - Configuration
# ============================================
# Copy this file to .env and customize for your environment

# ============================================
# Active LLM Backend
# ============================================
# Which backend to use: 'ollama' or 'lmstudio' (default: lmstudio)
ACTIVE_LLM_BACKEND=lmstudio

# ============================================
# LMStudio API Configuration
# ============================================
# Base URL for LMStudio API
LMSTUDIO_API_BASE=http://127.0.0.1:1234

# LMStudio API Endpoints
LMSTUDIO_MODELS_ENDPOINT=http://127.0.0.1:1234/v1/models
LMSTUDIO_CHAT_COMPLETIONS_ENDPOINT=http://127.0.0.1:1234/v1/chat/completions
LMSTUDIO_COMPLETIONS_ENDPOINT=http://127.0.0.1:1234/v1/completions
LMSTUDIO_EMBEDDINGS_ENDPOINT=http://127.0.0.1:1234/v1/embeddings
LMSTUDIO_HEALTH_CHECK_ENDPOINT=http://127.0.0.1:1234/v1/models

# ============================================
# OLLAMA API Configuration
# ============================================
# Base URL for Ollama API
OLLAMA_API_BASE=http://localhost:11434

# Ollama API Endpoints
OLLAMA_GENERATE_ENDPOINT=http://localhost:11434/api/generate
OLLAMA_MODELS_ENDPOINT=http://localhost:11434/api/tags
OLLAMA_VERSION_ENDPOINT=http://localhost:11434/api/version

# ============================================
# Model Configuration
# ============================================
# Default model parameters
DEFAULT_TEMPERATURE=0.7
DEFAULT_TOP_K=40
DEFAULT_TOP_P=0.9

# ============================================
# Request Timeouts (seconds)
# ============================================
# Time to wait for API health check
HEALTH_CHECK_TIMEOUT=5

# Time to wait for model list fetch
MODELS_FETCH_TIMEOUT=10

# Time to wait for model execution/inference
MODEL_EXECUTION_TIMEOUT=300

# ============================================
# API Server Configuration
# ============================================
# FastAPI server host and port
API_HOST=127.0.0.1
API_PORT=8000

# ============================================
# Application Settings
# ============================================
# Page title displayed in browser
PAGE_TITLE=Chat with Local AI

# Page icon/emoji
PAGE_ICON=🧠

# ============================================
# Remote Access (Optional - for ngrok tunneling)
# ============================================
# Your ngrok authentication token
# Get one at: https://dashboard.ngrok.com/auth/your-authtoken
# NGROK_AUTH_TOKEN=your_token_here

# ============================================
# Logging Configuration (Optional)
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# Security (Production Only)
# ============================================
# Enable CORS (use 'false' in production)
ENABLE_CORS=true

# ============================================
# Database Configuration (Future Use)
# ============================================
# DATABASE_URL=sqlite:///chat_history.db

# ============================================
# API Keys (Future Use)
# ============================================
# API_KEY=your_api_key_here
